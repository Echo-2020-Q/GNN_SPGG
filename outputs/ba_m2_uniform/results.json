      "frame_stride": 1,
      "layout": "spring",
      "spring_iterations": 80,
      "node_color_metric": "x_actual",
      "node_size_metric": "resources",
      "label_nodes": true,
      "macro_metrics": [
        "actual_cooperation_rate",
        "mean_resource",
        "mean_pool_grown",
        "mean_payoff",
        "gini"
      ],
      "save_dpi": 160
    },
    "output": {
