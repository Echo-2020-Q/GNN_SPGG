      "value_coef": 0.5,
      "max_grad_norm": 1.0,
      "eval_interval": 10,
      "eval_episodes": 3,
      "device": "cpu"
    },
    "rollout": {
      "episodes": 5,
      "post_training_eval_episodes": 2
    },
    "visualization": {
      "enable_micro_snapshots": true,
      "enable_macro_timeseries": true,
