      "type": "regular",
      "num_nodes": 100,
      "regular_degree": 4,
      "er_edge_prob": 0.04,
      "ws_degree": 4,
      "ws_rewiring_prob": 0.1,
      "ba_attachments_per_new_node": 2,
      "grid_rows": 10,
      "grid_cols": 10,
      "grid_periodic": false
    },
    "dynamics": {
      "alpha": 0.5,
      "r": 0.4,
      "p_max": 50.0,
      "beta": 1.0,
      "episode_length": 150,
      "initial_resource": 10.0,
      "initial_cooperation_prob": 0.5
    },
    "reward": {
      "lambda_payoff": 1.0,
      "lambda_cooperation": 0.0,
      "lambda_gini": 0.0,
      "epsilon": 1e-08
    },
    "gnn": {
      "hidden_dim": 64,
      "num_message_passing_layers": 2,
      "temperature": 1.0,
      "dirichlet_concentration_scale": 1.0,
      "dirichlet_concentration_floor": 0.1
    },
    "training": {
      "total_updates": 50,
      "steps_per_update": 64,
      "gamma": 0.99,
      "gae_lambda": 0.95,
      "learning_rate": 0.0003,
      "entropy_coef": 0.001,
      "value_coef": 0.5,
      "max_grad_norm": 1.0,
      "eval_interval": 10,
      "eval_episodes": 3,
      "device": "cpu"
    },
    "rollout": {
      "episodes": 5,
      "post_training_eval_episodes": 2
    },
    "visualization": {
      "enable_micro_snapshots": true,
      "enable_macro_timeseries": true,
      "episodes_to_visualize": [
        1
      ],
      "frame_stride": 1,
      "layout": "spring",
      "spring_iterations": 80,
      "node_color_metric": "x_actual",
      "node_size_metric": "resources",
      "label_nodes": true,
      "macro_metrics": [
        "actual_cooperation_rate",
        "mean_resource",
        "mean_pool_grown",
        "mean_payoff",
        "gini"
      ],
      "save_dpi": 160
    },
    "output": {
      "root_dir": "outputs",
